def descargar (url: str, folder_destino:str):
    if not os.path.exists(folder_destino):
        os.makedirs(folder_destino)
    nombre_archivo= url.split('/')[6].replace(" ","_")
    nombre_archivo=nombre_archivo+".txt"
    ruta_archivo=os.path.join(folder_destino,nombre_archivo)
    
    r = requests.get(url, stream=True)
    if r.ok:
        #print("Grabando en: ", os.path.abspath(ruta_archivo))
        array_rutas_destino.append(os.path.abspath(ruta_archivo))
        with open(ruta_archivo,'wb') as f:
            for chunk in r.iter_content(chunk_size=1024*8):
                if chunk:
                    f.write(chunk)
                    f.flush()
                    os.fsync(f.fileno())
    else:
        print("Descarga fallida: ".format(r.status_code,r.text))


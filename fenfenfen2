                           config=cfg, div_id=chart_id)
        cards.append(f"""
      <figure class="card">
        <h3>{title}</h3>
        <p class="sub">{sub}</p>
        {frag}
        <figcaption>Fuente: BCRP y Memoria Anual 2023 BCRP. Elaboracion propia.</figcaption>

_MESES = {"ene":1, "feb":2, "mar":3, "abr":4, "may":5, "jun":6,
          "jul":7, "ago":8, "set":9, "sep":9, "oct":10, "nov":11, "dic":12}


def _to_float(x):
    """Convierto celdas tipo '3,2' (formato ES) o numeros a float; None si no puedo."""
    if x is None:
        return None
    if isinstance(x, (int, float)):
        return float(x)
    s = str(x).strip().replace(" ", "").replace(",", ".")
    try:
        return float(s)
    except ValueError:
        return None


def load_primary_annual():
    """
    Construyo la serie ANUAL del PBI primario (var. % interanual) a partir de la
    hoja mensual del BCRP. La hoja 'anual' del archivo solo llega a 1952 para este
    agregado, asi que uso el promedio de las 12 variaciones interanuales del anio
    como proxy del crecimiento anual. Lo valide contra las cifras oficiales del
    BCRP (2016: 9.7 vs 9.8 oficial; 2025: 3.4 vs 3.2) y calza muy bien.
    Devuelvo solo anios completos (12 meses) para no mezclar anios parciales.
    """
    wb = openpyxl.load_workbook(FILE_BCRP, data_only=True)
    ws = wb["Mensuales"]
    rows = list(ws.iter_rows(values_only=True))

    # Identifico la columna 'Sectores Primarios' por su nombre en la fila 1.
    names = rows[1]
    col_prim = next(i for i, n in enumerate(names)
                    if n and "Sectores Primarios" in str(n))

    buckets = {}
    for r in rows[2:]:
        lab = r[0]
        if not lab:
            continue
        lab = str(lab)
        mes = _MESES.get(lab[:3].lower())
        if mes is None:
            continue
        yy = int(lab[3:])
        year = 1900 + yy if yy >= 90 else 2000 + yy
        val = _to_float(r[col_prim])
        if val is not None:
            buckets.setdefault(year, []).append(val)

    years, vals = [], []
    for y in sorted(buckets):
        v = buckets[y]
        if len(v) >= 12:                     # solo anios completos como observado
            years.append(y)
            vals.append(float(np.mean(v)))
    return np.array(years), np.array(vals)


def load_forecast():
    """
    Tomo la proyeccion del PBI primario del Reporte de Inflacion mas reciente
    (hoja 'Reporte de Inflacion 2026'). Uso una sola cosecha (RI Jun.26) para
    2026 y 2027, de modo que el forecast sea metodologicamente consistente.
    """
    wb = openpyxl.load_workbook(FILE_BCRP, data_only=True)
    ws = wb["Reporte de Inflacion 2026"]
    rows = list(ws.iter_rows(values_only=True))
    header = [str(c) if c is not None else "" for c in rows[0]]

    # Localizo columnas por etiqueta (misma cosecha RI Jun.26 para 2026 y 2027).
    def col_like(*keys):
        for i, h in enumerate(header):
            if all(k.lower() in h.lower() for k in keys):
                return i
        return None

    c_2026 = col_like("2026", "RI Jun")
    c_2027 = col_like("2027", "RI Jun")

    row_prim = next(r for r in rows[1:] if r and str(r[0]).strip().lower() == "pbi primario")
    f2026 = _to_float(row_prim[c_2026])
    f2027 = _to_float(row_prim[c_2027])
    return {2026: f2026, 2027: f2027}


def load_fen_episodes(min_magnitudes=("Fuerte", "Extraordinario")):
    """
    Leo el catalogo fechado de FEN de la Memoria 2023 (hoja 'p41') y me quedo
    con los episodios de mayor magnitud, que son los relevantes para el PBI.
    Devuelvo (anio_inicio, anio_fin, magnitud) en fraccion de anio para sombrear.
    """
    wb = openpyxl.load_workbook(FILE_MEMORIA, data_only=True)
    ws = wb["p41"]
    rows = list(ws.iter_rows(values_only=True))
    eps = []
    for r in rows[1:]:
        if r[0] is None:
            continue
        y0, m0, y1, m1, dur, mag = r[0], r[1], r[2], r[3], r[4], r[5]
        if mag not in min_magnitudes:
            continue
        start = y0 + (m0 - 1) / 12.0
        end = y1 + m1 / 12.0
        eps.append((start, end, str(mag)))
    return eps


# ----------------------------------------------------------------------------
# 3) Chart #1 en Plotly. Devuelvo un go.Figure interactivo, compacto y limpio.
#    El titulo/subtitulo van en el HTML (Seccion 6), no dentro del plot, para
#    evitar superposiciones y mantener el area del grafico despejada.
# ----------------------------------------------------------------------------
def chart_primary_fen():
    years, vals = load_primary_annual()
    fcst = load_forecast()
    episodes = load_fen_episodes()

    x0 = 1995
    mask = years >= x0
    yrs, vls = years[mask], vals[mask]
    last_y, last_v = int(yrs[-1]), float(vls[-1])
    fx = [last_y, 2026, 2027]
    fv = [last_v, fcst[2026], fcst[2027]]

    fig = go.Figure()

    # Bandas FEN de mayor magnitud (contexto, al fondo)
    for s, e, mag in episodes:
        if e < x0:
            continue
        fig.add_vrect(x0=s, x1=e, fillcolor=COL_FEN,
                      opacity=0.50 if mag == "Extraordinario" else 0.32,
                      line_width=0, layer="below")

    # Linea de 0% como unica referencia horizontal
    fig.add_hline(y=0, line_color=COL_ZERO, line_width=1)

    # Serie observada
    fig.add_trace(go.Scatter(
        x=yrs, y=vls, mode="lines", name="Observado",
        line=dict(color=COL_OBS, width=2.6),
        hovertemplate="<b>%{x}</b>   %{y:.1f}%<extra>Observado</extra>"))

    # Proyeccion BCRP (discontinua + marcadores, color distinto)
    fig.add_trace(go.Scatter(
        x=fx, y=fv, mode="lines+markers", name="Proyeccion BCRP (RI Jun.26)",
        line=dict(color=COL_FCST, width=2.6, dash="dot"),
        marker=dict(size=7, color=COL_FCST),
        hovertemplate="<b>%{x}</b>   %{y:.1f}%<extra>Proyeccion BCRP</extra>"))

    # Annotations (posicionadas para no superponerse)
    def yat(y):
        return float(vls[np.where(yrs == y)[0][0]])

    fig.add_annotation(x=1998, y=yat(1998) + 2.2, text="FEN 97-98",
                       showarrow=False, font=dict(size=11, color=COL_TXT_SOFT))
    fig.add_annotation(x=2020, y=yat(2020) - 2.4, text="COVID-19",
                       showarrow=False, font=dict(size=11, color=COL_TXT_SOFT))
    fig.add_annotation(x=2023.5, y=13.2, text="<b>FEN 2023-24</b>",
                       showarrow=False, font=dict(size=11, color="#5B6E9E"))
    fig.add_annotation(x=2026, y=fcst[2026], ay=34, ax=0,
                       text="<b>{:+.1f}%<br>2026</b>".format(fcst[2026]).replace(".", ","),
                       showarrow=True, arrowhead=0, arrowwidth=1.1,
                       arrowcolor=COL_FCST, yanchor="top",
                       font=dict(size=11.5, color=COL_FCST))
    fig.add_annotation(x=2027, y=fcst[2027] + 2.6,
                       text="<b>{:+.1f}%<br>2027</b>".format(fcst[2027]).replace(".", ","),
                       showarrow=False, font=dict(size=11, color=COL_FCST))

    ymin = min(vls.min(), min(fv)) - 3
    ymax = max(vls.max(), max(fv)) + 3
    fig.update_layout(
        height=340, margin=dict(l=40, r=16, t=6, b=52),
        plot_bgcolor="#fff", paper_bgcolor="#fff",
        font=dict(family=FONT, size=11, color=COL_TXT),
        hovermode="x unified",
        legend=dict(orientation="h", x=0, xanchor="left", y=-0.16, yanchor="top",
                    font=dict(size=10.5), bgcolor="rgba(0,0,0,0)"),
        xaxis=dict(range=[x0 - 0.5, 2027.9], dtick=5, ticks="outside",
                   tickfont=dict(size=10), showgrid=False,
                   linecolor="#C9CED6", tickcolor="#C9CED6"),
        yaxis=dict(range=[ymin, ymax], ticksuffix="%", dtick=5, ticks="outside",
                   tickfont=dict(size=10), showgrid=False, zeroline=False,
                   linecolor="#ffffff", tickcolor="#ffffff"))
    return fig



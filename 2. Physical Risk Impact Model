# 4. SENSIBILIDAD A ALPHA Y MONTE CARLO
# ============================================================================

def correr_pipeline_completo(scores, vulnerability, financieros, sector, alpha, escenario="moda"):
    impacto_hazard = calcular_impacto_por_hazard(scores, vulnerability, sector, alpha=alpha, escenario=escenario)
    impacto_total = agregar_impacto_total(impacto_hazard)
    ajuste_fin = ajustar_estados_financieros(financieros, impacto_total)
    return impacto_hazard, impacto_total, ajuste_fin


def sensibilidad_alpha(scores, vulnerability, financieros, sector,
                        rango_alpha=(1.0, 1.25, 1.5, 1.75, 2.0)):
    filas = []
    for a in rango_alpha:
        _, impacto_total, ajuste_fin = correr_pipeline_completo(
            scores, vulnerability, financieros, sector, alpha=a, escenario="moda"
        )
        filas.append({
            "alpha": a,
            "delta_revenue_pct": impacto_total["delta_revenue_total_pct"],
            "delta_ebitda_pct": ajuste_fin["delta_ebitda_pct"],
        })
    return filas


def _triangular(rng, minimo, moda, maximo):
    return rng.triangular(minimo, maximo, moda)


def monte_carlo(scores, vulnerability_detalle, pesos, financieros, sector,
                 n=N_SIMULACIONES_MONTE_CARLO, semilla=42):
    rng = random.Random(semilla)
    resultados_delta_ebitda = []


    for _ in range(n):
        alpha_sim = rng.uniform(1.0, 2.0)

        # Ruido +/-10% sobre cada variable de vulnerabilidad ya normalizada
        vars_sim = {}
        for k, v in vulnerability_detalle.items():
            ruido = rng.uniform(-0.10, 0.10)
            vars_sim[k] = _clip(v * (1 + ruido))
        v_sim = sum(pesos[k] * vars_sim[k] for k in pesos)

        elast_sim = {}
        for hazard, e in ELASTICIDADES[sector].items():
            rev = _triangular(rng, e["revenue"]["min"], e["revenue"]["moda"], e["revenue"]["max"])
            cogs = None
            if e["cogs"] is not None:
                cogs = _triangular(rng, e["cogs"]["min"], e["cogs"]["moda"], e["cogs"]["max"])
            elast_sim[hazard] = {"revenue": rev, "cogs": cogs}

        mapa_hazard_score = {
            "Movimiento de Masa": scores["score_mm"],
            "Inundación": scores["score_inund"],
            "Sequía": scores["score_sequia"],
        }
        d_rev_total = 0.0
        d_cogs_total = 0.0
        for hazard, score in mapa_hazard_score.items():
            intensidad = phi(score, alpha=alpha_sim)
            d_rev_total += intensidad * v_sim * elast_sim[hazard]["revenue"]
            if elast_sim[hazard]["cogs"] is not None:
                d_cogs_total += intensidad * v_sim * elast_sim[hazard]["cogs"]

        ajuste_fin = ajustar_estados_financieros(
            financieros, {"delta_revenue_total_pct": d_rev_total, "delta_cogs_total_pct": d_cogs_total}
        )
        resultados_delta_ebitda.append(ajuste_fin["delta_ebitda_pct"])

    def percentiles(lista, ps=(10, 25, 50, 75, 90)):
        lista_ordenada = sorted(lista)
        n_ = len(lista_ordenada)
        out = {}
        for p in ps:
            idx = min(n_ - 1, max(0, int(round(p / 100 * (n_ - 1)))))
            out[f"p{p}"] = lista_ordenada[idx]
        return out

    return {
        "delta_ebitda_pct": percentiles(resultados_delta_ebitda),
        "n_simulaciones": n,
    }



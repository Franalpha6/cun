def _clip(x, lo=0.0, hi=1.0):
    return max(lo, min(hi, x))


def cargar_score_riesgo(ruta_riesgos: str, empresa: str) -> dict:
    """Lee la hoja 'Score por Empresa' y devuelve los scores agregados."""
    wb = openpyxl.load_workbook(ruta_riesgos, data_only=True)
    ws = wb["Score por Empresa"]
    headers = [ws.cell(4, c).value for c in range(1, ws.max_column + 1)]
    idx = {h: i + 1 for i, h in enumerate(headers) if h}

    for r in range(5, ws.max_row + 1):
        if ws.cell(r, idx["Empresa"]).value == empresa:
            return {
                "empresa": empresa,
                "sector": ws.cell(r, idx["Sector"]).value,
                "aum_total_pen": ws.cell(r, idx["AUM Total (S/)"]).value,
                "score_mm": ws.cell(r, idx["Score MM"]).value,
                "score_inund": ws.cell(r, idx["Score Inund."]).value,
                "score_sequia": ws.cell(r, idx["Score Sequía"]).value,
                "score_global": ws.cell(r, idx["Score Global"]).value,
                "mitigante": ws.cell(r, idx["Mitigante (1S26)"]).value,
            }
    raise ValueError(f"Empresa '{empresa}' no encontrada en 'Score por Empresa'.")


def cargar_activos_empresa(ruta_riesgos: str, empresa: str) -> list:
    """Lee la hoja 'Activos por Empresa' filtrada a la empresa dada."""
    wb = openpyxl.load_workbook(ruta_riesgos, data_only=True)
    ws = wb["Activos por Empresa"]
    headers = [ws.cell(1, c).value for c in range(1, ws.max_column + 1)]
    idx = {h: i + 1 for i, h in enumerate(headers) if h}

    activos = []
    for r in range(2, ws.max_row + 1):
        if ws.cell(r, idx["Empresa"]).value == empresa:
            activos.append({
                "activo": ws.cell(r, idx["Activo Físico"]).value,
                "departamento": ws.cell(r, idx["Departamento"]).value,
                "score_mm": ws.cell(r, idx["Score MM"]).value,
                "score_inund": ws.cell(r, idx["Score Inund."]).value,
                "score_sequia": ws.cell(r, idx["Score Sequía"]).value,
                "monto_pen": ws.cell(r, idx["Plata del Activo (S/)"]).value,
            })
    return activos


def concentracion_geografica(activos: list) -> float:
    """
    % del AUM mapeado de la empresa concentrado en un solo departamento.
    Se usa directamente como sub-score de vulnerabilidad (ya en [0,1]).
    """
    if not activos:
        return None
    por_depto = {}
    total = 0.0
    for a in activos:
        monto = a["monto_pen"] or 0.0
        por_depto[a["departamento"]] = por_depto.get(a["departamento"], 0.0) + monto
        total += monto
    if total == 0:
        return None
    return max(por_depto.values()) / total


def _buscar_fila(ws, columna_etiqueta: int, etiqueta: str, fila_inicio=1, fila_fin=None):
    fila_fin = fila_fin or ws.max_row
    for r in range(fila_inicio, fila_fin + 1):
        if ws.cell(r, columna_etiqueta).value == etiqueta:
            return r
    return None



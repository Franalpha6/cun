        f"se mueva ='Cálculo'!B{r_debitda} por exposición climática."
    ))
    # La línea de arriba no es válida como texto+fórmula mezclados; la reemplazamos por dos celdas:
    ws2.cell(3, 1, f"Impacto esperado sobre EBITDA — {resultado['empresa']}, escenario base:")
    ws2.cell(3, 3, f"='Cálculo'!B{r_debitda}").number_format = "0.00%"
    ws2.cell(3, 3).font = Font(name=_FUENTE, bold=True, size=12, color="922B21")

    r = 5
    ws2.cell(r, 1, "Score Movimiento de Masa"); ws2.cell(r, 2, resultado["scores"]["score_mm"]); r += 1
    ws2.cell(r, 1, "Score Inundación"); ws2.cell(r, 2, resultado["scores"]["score_inund"]); r += 1
    ws2.cell(r, 1, "Score Sequía"); ws2.cell(r, 2, resultado["scores"]["score_sequia"]); r += 1
    ws2.cell(r, 1, "Mitigante declarado"); ws2.cell(r, 2, mitigante); r += 1
    ws2.cell(r, 1, "Vulnerability Score (0=protegida, 1=máxima exposición)")
    ws2.cell(r, 2, f"='Cálculo'!D{r_vuln_total}").number_format = "0.000"; r += 2

    _encabezados(ws2, r, ["Escenario", "Δ Revenue %", "Δ EBITDA %"])
    r += 1
    for nombre in ["conservador", "base", "severo"]:
        esc = resultado["resultados_escenarios"][nombre]
        ws2.cell(r, 1, nombre.capitalize())
        ws2.cell(r, 2, esc["impacto_total"]["delta_revenue_total_pct"]).number_format = "0.00%"
        ws2.cell(r, 3, esc["ajuste_fin"]["delta_ebitda_pct"]).number_format = "0.00%"
        r += 1
    ws2.cell(r + 1, 1, "Detalle completo del cálculo → hoja 'Cálculo'.").font = _NOTA_FONT
    _autoancho(ws2)

    # ================= HOJA "Sensibilidad" =================
    ws3 = wb.create_sheet("Sensibilidad")

    ws3.cell(3, 1, "Sensibilidad a Alpha (convexidad)").font = Font(name=_FUENTE, bold=True, color="1A5276")
    _encabezados(ws3, 4, ["Alpha", "Δ Revenue %", "Δ EBITDA %"])
    r = 5
    for fila in resultado["sensibilidad_alpha"]:
        ws3.cell(r, 1, fila["alpha"]).number_format = "0.00"
        ws3.cell(r, 2, fila["delta_revenue_pct"]).number_format = "0.00%"
        ws3.cell(r, 3, fila["delta_ebitda_pct"]).number_format = "0.00%"
        r += 1

    r += 2
    mc = resultado["monte_carlo"]
    ws3.cell(r, 1, f"Monte Carlo — {mc['n_simulaciones']:,} simulaciones").font = Font(name=_FUENTE, bold=True, color="1A5276")
    r += 1
    _encabezados(ws3, r, ["Percentil", "Δ EBITDA %"])
    r += 1
    for p in ["p10", "p25", "p50", "p75", "p90"]:
        ws3.cell(r, 1, p)
        ws3.cell(r, 2, mc["delta_ebitda_pct"][p]).number_format = "0.00%"
        r += 1
    _autoancho(ws3)

    wb.save(ruta_salida)
    print(f"\nExcel guardado en: {ruta_salida}")


def main():
    for config in EMPRESAS_A_PROCESAR:
        empresa = config["empresa"]
        sector = config["sector"]
        archivo_valorizacion = config["archivo_valorizacion"]
        rio_proxy_hidro = config["rio_proxy_hidro"]

        recursos = resolver_recursos_empresa(archivo_valorizacion, sector, PERIODO_RIESGOS)

        if not all(recursos[k]["encontrado"] for k in ("modelo_valorizacion", "riesgos_climaticos", "bd_sectorial")):
            print(f"\nNos saltamos a {empresa}: faltan uno o más archivos de insumo.\n")
            continue

        ruta_valorizacion = recursos["modelo_valorizacion"]["ruta"]
        ruta_riesgos = recursos["riesgos_climaticos"]["ruta"]
        ruta_bd_sectorial = recursos["bd_sectorial"]["ruta"]

        print(f"\nCorriendo framework para {empresa} ({sector})...\n")
        resultado = correr_framework_empresa(
            ruta_valorizacion, ruta_riesgos, ruta_bd_sectorial, empresa, sector, rio_proxy_hidro
        )

        print("\n=== RESUMEN ===")
        print("Scores:", resultado["scores"])
        print("Concentración geográfica:", resultado["geo_concentracion"])
        print("Vulnerability score:", resultado["vulnerability"]["vulnerability_score"])
        print("Detalle vulnerability:", resultado["vulnerability"]["detalle"])
        print("\nSensibilidad alpha:", resultado["sensibilidad_alpha"])
        print("\nMonte Carlo:", resultado["monte_carlo"])
        print("\nCross-check:", resultado["cross_check"])

        ruta_salida = r"Z:\Mesa de Inversiones\Bottom-Up\Franco\Resultado_" + empresa + ".xlsx"
        escribir_excel_resultados(resultado, ruta_salida)



if __name__ == "__main__":
    main()

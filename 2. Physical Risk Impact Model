def cargar_financieros(ruta_valorizacion: str, empresa: str, anio_base: int = 2025) -> dict:
    config = CONFIG_EMPRESAS[empresa]
    wb = openpyxl.load_workbook(ruta_valorizacion, data_only=True)
    ws = wb[config["hoja_ratios"]]

    headers = [ws.cell(2, c).value for c in range(1, ws.max_column + 1)]
    col_anio = None
    for c, h in enumerate(headers, start=1):
        if h == anio_base:
            col_anio = c
            break
    if col_anio is None:
        raise ValueError(f"No encontramos la columna del año {anio_base} en '{config['hoja_ratios']}'.")

    def valor(etiqueta):
        fila = _buscar_fila(ws, 1, etiqueta)
        if fila is None:
            return None
        return ws.cell(fila, col_anio).value

    return {
        "anio_base": anio_base,
        "revenue_usd": valor("Revenue"),
        "ebitda_usd": valor("EBITDA"),
        "ebitda_margin": valor("EBITDA Margin (%)"),
        "net_debt_ebitda_x": valor("Net debt / EBITDA (x)"),
        "current_ratio_x": valor("Current ratio (x)"),
        "net_ppe_usd": valor("Net PPE"),
        "total_assets_usd": valor("Total assets"),
    }



def cargar_produccion(ruta_valorizacion: str) -> dict:
    """Lee la hoja 'Production' y devuelve generación Hidro/Termo anual."""
    wb = openpyxl.load_workbook(ruta_valorizacion, data_only=True)
    ws = wb["Production"]
    headers = [ws.cell(2, c).value for c in range(1, ws.max_column + 1)]

    filas = {}
    for r in range(1, 12):
        etiqueta = ws.cell(r, 2).value
        if etiqueta in ("Hidro", "Termo", "Total generación"):
            filas[etiqueta] = r

    resultado = {}
    for etiqueta, fila in filas.items():
        serie_anual = {}
        for c, h in enumerate(headers, start=1):
            if isinstance(h, int) and h > 2000:
                v = ws.cell(fila, c).value
                if v is not None:
                    serie_anual[h] = v
        resultado[etiqueta] = serie_anual

    return resultado


def cargar_caudal_rio_anual(ruta_bd_sectorial: str, rio: str) -> dict:
    """Lee 'BD_Utilities.xlsm' -> hoja '4. Caudales y Volumen', promedio anual (m3/s)."""
    wb = openpyxl.load_workbook(ruta_bd_sectorial, data_only=True, keep_vba=True)
    ws = wb["4. Caudales y Volumen"]

    fila_rio = None
    for r in range(8, ws.max_row + 1):
        if ws.cell(r, 6).value == rio:
            fila_rio = r
            break
    if fila_rio is None:
        raise ValueError(f"Río '{rio}' no encontrado en la hoja de caudales.")

    por_anio = {}
    for c in range(8, ws.max_column + 1):
        anio = ws.cell(6, c).value
        caudal = ws.cell(fila_rio, c).value
        if isinstance(anio, (int, float)) and isinstance(caudal, (int, float)):
            por_anio.setdefault(int(anio), []).append(caudal)

    return {anio: statistics.mean(vals) for anio, vals in sorted(por_anio.items())}



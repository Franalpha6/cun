def phi(score, alpha=ALPHA_CONVEXIDAD):
    """
    Mapeo convexo score CENEPRED (1-5) -> intensidad económica [0,1].
    Si score <= 1 (incluye el caso de scores diluidos por N/D, ej. 0.22),
    se trata como intensidad 0: no hay evidencia de exposición por debajo
    del piso de la escala. Esto es una consecuencia directa, no un parche,
    de la limitación de dilución por datos faltantes ya documentada.
    """
    if score is None or score <= 1:
        return 0.0
    return ((score - 1) ** alpha) / ((5 - 1) ** alpha)


def normalizar_variables_vulnerability(financieros: dict, produccion: dict, mitigante, sector: str) -> dict:
    net_debt_ebitda = financieros["net_debt_ebitda_x"] or 0
    current_ratio = financieros["current_ratio_x"] or 0
    ebitda_margin = financieros["ebitda_margin"] or 0
    net_ppe = financieros["net_ppe_usd"] or 0
    total_assets = financieros["total_assets_usd"] or 1

    if sector == "Utilities":
        anio = financieros["anio_base"]
        hidro = produccion.get("Hidro", {}).get(anio, 0) or 0
        total_gen = produccion.get("Total generación", {}).get(anio, 0) or 1
        dependencia_hidrica = hidro / total_gen if total_gen else 0
    else:
        # Para Minería (y cualquier sector sin data de generación propia)
        # todavía no tenemos cómo medir esto, así que usamos un valor
        # neutro. Queda marcado como limitación, no como cálculo real.
        dependencia_hidrica = 0.5

    leverage_v = _clip(net_debt_ebitda / NORMALIZACION["leverage_cap_x"])
    liquidez_v = _clip(
        (NORMALIZACION["liquidez_buena_x"] - current_ratio)
        / (NORMALIZACION["liquidez_buena_x"] - NORMALIZACION["liquidez_mala_x"])
    )
    margen_v = _clip(
        (NORMALIZACION["margen_bueno_pct"] - ebitda_margin)
        / (NORMALIZACION["margen_bueno_pct"] - NORMALIZACION["margen_malo_pct"])
    )
    activos_fijos_v = _clip(net_ppe / total_assets)
    adaptacion_v = MAPA_MITIGANTE_A_VULNERABILIDAD.get(mitigante, 1.0)

    return {
        "leverage": leverage_v,
        "liquidez": liquidez_v,
        "margen_operativo": margen_v,
        "intensidad_activos_fijos": activos_fijos_v,
        "dependencia_hidrica": _clip(dependencia_hidrica),
        "capacidad_adaptacion": adaptacion_v,
    }



def calcular_vulnerability_score(variables_norm: dict, sector: str) -> dict:
    pesos = PESOS_VULNERABILITY[sector]
    v_total = sum(pesos[k] * variables_norm[k] for k in pesos)
    return {"vulnerability_score": v_total, "detalle": variables_norm, "pesos": pesos}


def calcular_impacto_por_hazard(scores: dict, vulnerability: float, sector: str,
                                 alpha=ALPHA_CONVEXIDAD, escenario="moda") -> dict:
    """
    Devuelve, por hazard, el delta% sobre revenue y sobre COGS, para el
    escenario indicado ("min"=conservador en magnitud de impacto positivo
    para la empresa / menor daño, "moda"=base, "max"=severo).
    """
    mapa_hazard_score = {
        "Movimiento de Masa": scores["score_mm"],
        "Inundación": scores["score_inund"],
        "Sequía": scores["score_sequia"],
    }
    resultado = {}
    for hazard, score in mapa_hazard_score.items():
        elast = ELASTICIDADES[sector][hazard]
        intensidad = phi(score, alpha=alpha)
        delta_revenue = intensidad * vulnerability * elast["revenue"][escenario]
        delta_cogs = None
        if elast["cogs"] is not None:
            delta_cogs = intensidad * vulnerability * elast["cogs"][escenario]
        resultado[hazard] = {
            "score": score,
            "intensidad_phi": intensidad,
            "delta_revenue_pct": delta_revenue,
            "delta_cogs_pct": delta_cogs,
        }
    return resultado


def agregar_impacto_total(impacto_por_hazard: dict) -> dict:
    """Suma across hazards. Se tratan como independientes (sin haircut),
    consistente con la metodología documentada."""
    total_revenue = sum(v["delta_revenue_pct"] for v in impacto_por_hazard.values())
    total_cogs = sum(v["delta_cogs_pct"] for v in impacto_por_hazard.values() if v["delta_cogs_pct"])
    return {"delta_revenue_total_pct": total_revenue, "delta_cogs_total_pct": total_cogs}


def ajustar_estados_financieros(financieros: dict, impacto_total: dict) -> dict:
    revenue_base = financieros["revenue_usd"]
    ebitda_base = financieros["ebitda_usd"]
    margen_base = ebitda_base / revenue_base if revenue_base else None

    d_rev = impacto_total["delta_revenue_total_pct"]
    d_cogs = impacto_total["delta_cogs_total_pct"]

    revenue_adj = revenue_base * (1 + d_rev)
    cogs_base = revenue_base - ebitda_base
    cogs_adj = cogs_base * (1 + d_cogs)
    ebitda_adj = revenue_adj - cogs_adj

    net_debt = financieros["net_debt_ebitda_x"] * ebitda_base if financieros["net_debt_ebitda_x"] else None
    net_debt_ebitda_adj = net_debt / ebitda_adj if net_debt and ebitda_adj else None

    return {
        "revenue_base": revenue_base,
        "revenue_ajustado": revenue_adj,
        "ebitda_base": ebitda_base,
        "ebitda_ajustado": ebitda_adj,
        "delta_ebitda_pct": (ebitda_adj / ebitda_base - 1) if ebitda_base else None,
        "net_debt_ebitda_base_x": financieros["net_debt_ebitda_x"],
        "net_debt_ebitda_ajustado_x": net_debt_ebitda_adj,
    }






def cross_check_hidro_vs_caudal(produccion: dict, caudal_anual: dict, anios_covid=(2020,)) -> list:
    hidro = produccion.get("Hidro", {})
    filas = []
    anios_comunes = sorted(set(hidro.keys()) & set(caudal_anual.keys()))
    for anio in anios_comunes:
        filas.append({
            "anio": anio,
            "hidro_gwh": hidro[anio],
            "caudal_promedio_m3s": caudal_anual[anio],
            "nota": "Año atípico (demanda COVID-19)" if anio in anios_covid else "",
        })
    return filas



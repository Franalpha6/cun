def correr_framework_empresa(ruta_valorizacion, ruta_riesgos, ruta_bd_sectorial,
                              empresa, sector, rio_proxy_hidro):
    print(f"Cargando datos para {empresa}...")
    scores = cargar_score_riesgo(ruta_riesgos, empresa)
    activos = cargar_activos_empresa(ruta_riesgos, empresa)
    financieros = cargar_financieros(ruta_valorizacion, empresa, anio_base=2025)

    # El cruce con caudal de río solo lo armamos para Utilities (generación
    # hidro). Para Minería todavía no tenemos ese dato, así que lo dejamos
    # vacío y seguimos de largo.
    if sector == "Utilities":
        produccion = cargar_produccion(ruta_valorizacion)
        caudal_anual = cargar_caudal_rio_anual(ruta_bd_sectorial, rio_proxy_hidro)
    else:
        produccion = {}
        caudal_anual = {}

    geo_concentracion = concentracion_geografica(activos)
    vars_norm = normalizar_variables_vulnerability(financieros, produccion, scores["mitigante"], sector)
    vars_norm["concentracion_geografica"] = geo_concentracion or 0.0

    vulnerability = calcular_vulnerability_score(vars_norm, sector)


    print("Corriendo escenarios conservador/severo...")
    resultados_escenarios = {}
    for nombre_escenario, clave in [("conservador", "max"), ("base", "moda"), ("severo", "min")]:
        ih, it, af = correr_pipeline_completo(
            scores, vulnerability["vulnerability_score"], financieros, sector,
            alpha=ALPHA_CONVEXIDAD, escenario=clave
        )
        resultados_escenarios[nombre_escenario] = {
            "impacto_hazard": ih, "impacto_total": it, "ajuste_fin": af,
        }

    print("Corriendo sensibilidad a alpha...")
    sens_alpha = sensibilidad_alpha(scores, vulnerability["vulnerability_score"], financieros, sector)

    print(f"Corriendo Monte Carlo ({N_SIMULACIONES_MONTE_CARLO:,} simulaciones)...")
    mc = monte_carlo(scores, vulnerability["detalle"], vulnerability["pesos"], financieros, sector)

    print("Corriendo cross-check hidro vs. caudal...")
    if sector == "Utilities":
        cross_check = cross_check_hidro_vs_caudal(produccion, caudal_anual)
    else:
        cross_check = []

    return {
        "empresa": empresa,
        "sector": sector,
        "scores": scores,
        "activos": activos,
        "geo_concentracion": geo_concentracion,
        "financieros": financieros,
        "produccion": produccion,
        "caudal_anual": caudal_anual,
        "vulnerability": vulnerability,
        "resultados_escenarios": resultados_escenarios,
        "sensibilidad_alpha": sens_alpha,
        "monte_carlo": mc,
        "cross_check": cross_check,
    }




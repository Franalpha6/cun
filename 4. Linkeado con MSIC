    df_PT2 = df_PT2.loc[:, ['Fecha','Afp','Strategy','Fondo','assetclass',"Factor",'Nombre','Rating','Weight','Score','ESG','CONTROVERSIES','CO2/Sales','Cod. OriginadorBU']]

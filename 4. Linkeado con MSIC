def Contribuyentes(result_bd):
    result_bd['Peso'] = result_bd.groupby(["Fecha", "Afp", "Fondo", 'Nombre'])['Weight'].transform('sum')
    result_bd = result_bd.drop(['Weight'], axis=1)
    result_bd["Fecha"] = pd.to_datetime(result_bd["Fecha"])  # Convertir la columna a datetime
    result_bd["key2"] = result_bd["Nombre"] + result_bd["Fondo"] + result_bd["Afp"] + result_bd["Fecha"].dt.strftime('%Y-%m-%d')
    result_bd = result_bd.drop(['SBS','ISIN','Precio','Q'], axis=1)
    result_bd = result_bd.drop_duplicates(subset ='key2') 
    result_bd = result_bd.drop(['key2'], axis=1)
    result_bd = result_bd.rename(columns={'Peso':'Weight'})
    
    df = result_bd.copy(deep=True)
    df = df.drop(df.loc[df['RATING'].isin([None,"No cov","AAA","AA","A"])].index)
    df.drop(df[df['Weight'] < 0.002].index, inplace=True)
    df["id"] = df["Afp"]+ df["Fondo"]
    df["SC"] = df['assetclass'].apply(lambda x: x[0:2])
    df["id2"] = df["SC"]+ df["Afp"]
    
    N = 4
    dfe = df.sort_values(by=['id', 'E'], ascending=[True, True]).groupby('id', as_index=False).nth[:N]
    dfe.insert(5, 'Factor', 'E')
    dfs = df.sort_values(by=['id', 'S'], ascending=[True, True]).groupby('id', as_index=False).nth[:N]
    dfs["E"] = dfs["S"]
    dfs.insert(5, 'Factor', 'S')
    dfg = df.sort_values(by=['id', 'G'], ascending=[True, True]).groupby('id', as_index=False).nth[:N]
    dfg["E"] = dfg["G"]
    dfg.insert(5, 'Factor', 'X')
    df_T = pd.concat([dfe, dfs, dfg])
    df_T["id6"] = df_T["id"]+ df_T["Factor"]
    df_T = df_T.sort_values('id6', ascending = True)
    #RV RF
    N = 3
    df2 = df.copy(deep=True)
    df2 = df2.drop(df.loc[df['Fondo'].isin(["F1","F2", "F3"])].index) 
    dfe1 = df2.sort_values(by=['id2', 'E'], ascending=[True, True]).groupby('id2', as_index=False).nth[:N]
    dfe1.insert(5, 'Factor', 'E')
    dfs1 = df2.sort_values(by=['id2', 'S'], ascending=[True, True]).groupby('id2', as_index=False).nth[:N]
    dfs1["E"] = dfs1["S"]
    dfs1.insert(5, 'Factor', 'S')
    dfg1 = df2.sort_values(by=['id2', 'G'], ascending=[True, True]).groupby('id2', as_index=False).nth[:N]
    dfg1["E"] = dfg1["G"]
    dfg1.insert(5, 'Factor', 'X')
    df_T1 = pd.concat([dfe1, dfs1, dfg1])
    df_T1["Fondo"] = df_T1["SC"]

    df_T1["id7"] = df_T1["id2"]+ df_T1["Factor"]
    df_T1 = df_T1.sort_values('id7', ascending = True)
    df_PT = pd.concat([df_T, df_T1])
    df_PT.rename(columns={'E':'Score', 'RATING':'Rating', 'INDUSTRY_ADJUSTED_SCORE':'ESG'},inplace=True)
    df_PT = df_PT.drop(['S','G','id','id2','SC','id6','id7'], axis=1)
    df_PT['Factor']  = df_PT['Factor'].replace(['X'],['G'])

    dfin = df_PT.drop(df_PT.loc[df['Afp'].isin(["Habitat","Profuturo","Prima"])].index)

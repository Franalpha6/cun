donde los archivos "2015GastoFenomenoNino" y "2016GastoFenomenoNino" tendrás una columna "MONTO_DEVENGADO" (considerarlo como el monto ejecutado) y la columna "ASIGNACION_PRESUPUESTARIA" que es el monto de plata asignado, de allí ya simplemente ya es intuitivo saber que proporción fue ejecutada y que proporción no lo fue del monto de plata asignado. 
Mientras que para los archivos "2023GastoEmergenciasFEN" y "2024GastoEmergenciasFEN" también hay una columna llamada "MONTO_DEVENGADO" que cumple la función que ya sabes, mientras que la columna "MARCO_PRESUPUESTAL" es el monto de plata asignado asi como lo es "ASIGNACION_PRESUPUESTARIA" en el primer caso. De allí la lógica a continuación es la correcta: def chart_fen_fiscal():
    """
    Comparo la escala del esfuerzo fiscal entre los episodios FEN 2015-16,
    2023-24 y el presupuesto 2026 de prevencion de desastres (PP 0068).
    Uso barmode overlay: la barra de presupuesto queda detras y la porcion
    expuesta arriba es la brecha de ejecucion. Para 2015-16 solo existe
    devengado (no hay marco presupuestal en esos datasets).
    """
    df15 = pd.read_csv(FILE_FEN_2015)
    df16 = pd.read_csv(FILE_FEN_2016)
    df23 = pd.read_csv(FILE_FEN_2023)
    df24 = pd.read_csv(FILE_FEN_2024)

    dev_1516   = (df15.MONTO_DEVENGADO.sum() + df16.MONTO_DEVENGADO.sum()) / 1e9
    marco_2324 = (df23.MARCO_PRESUPUESTAL.sum() + df24.MARCO_PRESUPUESTAL.sum()) / 1e9
    dev_2324   = (df23.MONTO_DEVENGADO.sum() + df24.MONTO_DEVENGADO.sum()) / 1e9

    # MEF consulta amigable 2026 — PP 0068 Reduccion de Vulnerabilidad
    wb = openpyxl.load_workbook(FILE_MEF_2026, data_only=True)
    ws = wb["ejecucion del gasto"]
    pim_26, dev_26 = 0.0, 0.0
    for r in ws.iter_rows(values_only=True):
        if r[0] and "0068" in str(r[0]):
            pim_26 = _to_float(r[2]) / 1e9
            dev_26 = _to_float(r[6]) / 1e9
            break

    labs       = ["FEN 2015\u201316", "FEN 2023\u201324", "Prev. desastres\n2026 (a ago.)"]
    marcos     = [None,       marco_2324,  pim_26]
    devengados = [dev_1516,   dev_2324,    dev_26]

    fig = go.Figure()

    # Capa 1 — Presupuesto (detras, color suave)
    fig.add_trace(go.Bar(
        x=labs, y=marcos, name="Presupuesto (Marco / PIM)",
        marker_color="#AFC3E6", width=0.50, opacity=0.85,
        hovertemplate="<b>%{x}</b><br>Presupuesto: S/ %{y:.2f} mil MM<extra></extra>"))

    # Capa 2 — Ejecutado (delante, teal institucional)
    fig.add_trace(go.Bar(
        x=labs, y=devengados, name="Ejecutado (Devengado)",
        marker_color=COL_OBS, width=0.50,
        hovertemplate="<b>%{x}</b><br>Ejecutado: S/ %{y:.2f} mil MM<extra></extra>"))

    # --- Annotations ---
    # FEN 2015-16: solo devengado
    fig.add_annotation(
        x=labs[0], y=dev_1516 + 0.12, yanchor="bottom", showarrow=False,
        text="<b>S/ {:.1f} mil MM</b>".format(dev_1516).replace(".", ","),
        font=dict(size=11.5, color=COL_OBS))
    fig.add_annotation(
        x=labs[0], y=dev_1516 + 0.55, yanchor="bottom", showarrow=False,
        text="<i>Sin dato de marco</i>",
        font=dict(size=9, color=COL_TXT_SOFT))

    # FEN 2023-24
    rate_2324 = dev_2324 / marco_2324 * 100
    gap_2324  = marco_2324 - dev_2324
    fig.add_annotation(
        x=labs[1], y=marco_2324 + 0.12, yanchor="bottom", showarrow=False,
        text="<b>Ejec. {:.0f}%</b>".format(rate_2324),
        font=dict(size=12, color=COL_FCST))
    fig.add_annotation(
        x=labs[1], y=marco_2324 + 0.52, yanchor="bottom", showarrow=False,
        text="Brecha: S/ {:.1f} mil MM".format(gap_2324).replace(".", ","),
        font=dict(size=9, color=COL_TXT_SOFT))

    # PP 0068 — 2026
    rate_26 = dev_26 / pim_26 * 100
    gap_26  = pim_26 - dev_26
    fig.add_annotation(
        x=labs[2], y=pim_26 + 0.12, yanchor="bottom", showarrow=False,
        text="<b>Ejec. {:.0f}%</b>".format(rate_26),
        font=dict(size=12, color=COL_FCST))
    fig.add_annotation(
        x=labs[2], y=pim_26 + 0.52, yanchor="bottom", showarrow=False,
        text="Brecha: S/ {:.1f} mil MM".format(gap_26).replace(".", ","),
        font=dict(size=9, color=COL_TXT_SOFT))

    ymax = max(v for v in marcos + devengados if v is not None) * 1.30

    fig.update_layout(
        barmode="overlay",
        height=340, margin=dict(l=40, r=16, t=6, b=52),
        plot_bgcolor="#fff", paper_bgcolor="#fff",
        font=dict(family=FONT, size=11, color=COL_TXT),
        hovermode="x unified",
        legend=dict(orientation="h", x=0, xanchor="left", y=-0.16, yanchor="top",
                    font=dict(size=10.5), bgcolor="rgba(0,0,0,0)"),
        xaxis=dict(showgrid=False, linecolor="#C9CED6", tickcolor="#C9CED6",
                   tickfont=dict(size=11)),
        yaxis=dict(range=[0, ymax],
                   title=dict(text="Miles de millones de S/", font=dict(size=10)),
                   showgrid=False, tickfont=dict(size=10),
                   linecolor="#ffffff", tickcolor="#ffffff"),
    )
    return fig

